---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import SpeakerDeckEmbed from '../components/SpeakerDeckEmbed.astro';
import RevealDeckEmbed from '../components/RevealDeckEmbed.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_AUTHOR } from '../consts';
import { getCachedSlide } from '../lib/speakerdeck';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	type?: 'speakerdeck' | 'revealjs';
	slug: string;
	speakerdeck_link?: string;
	cover?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	type = 'speakerdeck',
	slug,
	speakerdeck_link,
	cover,
} = Astro.props;

const slide = speakerdeck_link ? getCachedSlide(speakerdeck_link) : undefined;
const pageURL = new URL(Astro.url.pathname, Astro.site);
const coverImage = cover || slide?.cover;

const presentation = {
	'@context': 'https://schema.org',
	'@type': 'PresentationDigitalDocument',
	name: title,
	description,
	url: pageURL.toString(),
	...(speakerdeck_link && { sameAs: speakerdeck_link }),
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: { '@type': 'Person', name: SITE_AUTHOR, url: Astro.site?.toString() },
	...(coverImage && { image: coverImage, thumbnailUrl: coverImage }),
};

const breadcrumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Slides',
			item: new URL('/slides', Astro.site).toString(),
		},
		{ '@type': 'ListItem', position: 3, name: title, item: pageURL.toString() },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	image={coverImage}
	type="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	author={SITE_AUTHOR}
>
	<JsonLd data={[presentation, breadcrumbs]} />
	<article class="slide-page">
		<header class="slide-header">
			<p class="eyebrow">{type === 'revealjs' ? 'Talk · Reveal.js' : 'Talk · SpeakerDeck'}</p>
			<h1>{title}</h1>
			{description && <p class="lede">{description}</p>}
			<div class="meta-row">
				<PostMeta pubDate={pubDate} updatedDate={updatedDate} />
				{
					type === 'revealjs' ? (
						<a class="deck-link deck-link-primary" href={`/slides/${slug}/deck/`} target="_blank" rel="noopener">
							Present Fullscreen ↗
						</a>
					) : speakerdeck_link ? (
						<a class="deck-link" href={speakerdeck_link} target="_blank" rel="noopener">
							Open on SpeakerDeck ↗
						</a>
					) : null
				}
			</div>
		</header>

		{
			type === 'revealjs' ? (
				<RevealDeckEmbed slug={slug} title={title} />
			) : speakerdeck_link ? (
				<SpeakerDeckEmbed url={speakerdeck_link} title={title} />
			) : null
		}

		<div class="reading-tech notes">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.slide-header {
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--rule);
		padding-bottom: 1.5rem;
	}
	.eyebrow {
		margin: 0 0 0.35rem;
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.78rem;
		color: var(--accent);
	}
	.slide-header h1 {
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.02em;
		font-size: 2.6rem;
		line-height: 1.15;
		margin: 0 0 0.2em;
	}
	.lede {
		font-family: var(--font-sans);
		font-size: 1.1rem;
		color: var(--ink-soft);
		margin: 0.45rem 0 1rem;
		line-height: 1.5;
	}
	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem 1rem;
		align-items: center;
		justify-content: space-between;
	}
	.deck-link {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--accent);
		transition: opacity 0.15s ease;
	}
	.deck-link:hover {
		opacity: 0.8;
		text-decoration: underline;
	}
	.deck-link-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.75rem;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 6px;
		color: var(--accent);
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.deck-link-primary:hover {
		background: var(--highlight);
		border-color: var(--accent);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.notes {
		margin-top: 2rem;
	}
</style>
