---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cleanSlug } from '../lib/slug';
import { getCachedSlide } from '../lib/speakerdeck';

const slides = (await getCollection('slides', ({ data }) => !data.draft))
	.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
	.map((entry) => {
		const deck = entry.data.type === 'speakerdeck' && entry.data.url
			? getCachedSlide(entry.data.url)
			: undefined;
		return {
			entry,
			cover: entry.data.cover || deck?.cover,
		};
	});
---

<BaseLayout
	title="Slides · Arnav Gupta"
	description="Talks and presentations by Arnav Gupta, featuring interactive Reveal.js decks and SpeakerDeck slides."
	wide
>
	<header class="page-head">
		<h1 class="kicker">Slides</h1>
		<p class="blurb">Talks and lecture decks I've given at conferences, meetups, and universities.</p>
	</header>

	{
		slides.length === 0 ? (
			<p class="empty">No slide pages yet.</p>
		) : (
			<div class="grid">
				{slides.map(({ entry, cover }) => {
					const data = entry.data;
					const isReveal = data.type === 'revealjs';
					const pubDate = new Date(data.date);
					const slug = cleanSlug(data.slug || entry.id);

					return (
						<a class="card" href={`/slides/${slug}/`} title={data.title}>
							{cover ? (
								<div class="thumb">
									<img src={cover} alt="" loading="lazy" width="710" height="399" />
									<span class={`pill ${data.type}`}>
										{isReveal ? 'Reveal.js' : 'SpeakerDeck'}
									</span>
								</div>
							) : (
								<div class="thumb thumb-reveal">
									<div class="thumb-reveal-content">
										<Icon name="tabler:presentation" class="thumb-icon" />
										<span class="thumb-title">{data.title}</span>
									</div>
									<span class={`pill ${data.type}`}>
										{isReveal ? 'Reveal.js' : 'SpeakerDeck'}
									</span>
								</div>
							)}
							<div class="body">
								<h2>{data.title}</h2>
								{data.description && <p class="desc">{data.description}</p>}
								<time class="date" datetime={pubDate.toISOString()}>
									{pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
							</div>
						</a>
					);
				})}
			</div>
		)
	}
</BaseLayout>

<style>
	.kicker {
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.8rem;
		font-weight: normal;
		color: var(--accent);
		margin: 0 0 0.2em;
	}
	.blurb {
		font-family: var(--font-sans);
		font-size: 1.15rem;
		color: var(--ink-soft);
		margin-bottom: 2em;
		max-width: 44rem;
	}
	.empty {
		font-family: var(--font-sans);
		color: var(--ink-soft);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em;
	}
	.card {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--rule);
		border-radius: 10px;
		overflow: hidden;
		background: var(--paper-raised);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.thumb {
		position: relative;
		aspect-ratio: 710 / 399;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.thumb-reveal {
		background: linear-gradient(135deg, #08111f 0%, #0d1e38 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
		text-align: center;
	}
	.thumb-reveal-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		color: #eef2ff;
	}
	.thumb-icon {
		width: 2.2rem;
		height: 2.2rem;
		color: var(--accent);
	}
	.thumb-title {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.25;
		color: #eef2ff;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.pill {
		position: absolute;
		bottom: 0.6rem;
		right: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
		backdrop-filter: blur(8px);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 500;
	}
	.pill.speakerdeck {
		background: rgba(0, 0, 0, 0.7);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}
	.pill.revealjs {
		background: rgba(103, 232, 249, 0.2);
		color: #67e8f9;
		border: 1px solid rgba(103, 232, 249, 0.4);
	}
	.body {
		padding: 1em 1.05em 1.15em;
	}
	.card h2 {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.3;
		margin: 0;
	}
	.card:hover h2 {
		color: var(--accent);
	}
	.desc {
		margin: 0.55em 0 0;
		font-size: 0.95rem;
		color: var(--ink-soft);
		line-height: 1.4;
	}
	.date {
		display: block;
		margin-top: 0.75em;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}
</style>
