---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cleanSlug } from '../lib/slug';
import { getCachedSlide } from '../lib/speakerdeck';

const slides = (await getCollection('slides', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((entry) => ({
		entry,
		deck: getCachedSlide(entry.data.speakerdeck_link),
	}));
---

<BaseLayout
	title="Slides · Arnav Gupta"
	description="Talks and presentations by Arnav Gupta, with embedded SpeakerDeck slides and notes."
	wide
>
	<header class="page-head">
		<h1 class="kicker">Slides</h1>
		<p class="blurb">
			Talks I've given at meetups and conferences. Each deck has its own page here,
			with the SpeakerDeck slides embedded and room for notes about the event.
		</p>
	</header>

	{
		slides.length === 0 ? (
			<p class="empty">No slide pages yet.</p>
		) : (
			<div class="grid">
				{slides.map(({ entry, deck }) => (
					<a class="card" href={`/slides/${cleanSlug(entry.id)}/`} title={entry.data.title}>
						{deck?.cover ? (
							<div class="thumb">
								<img src={deck.cover} alt="" loading="lazy" width="710" height="399" />
							</div>
						) : (
							<div class="thumb thumb-fallback" aria-hidden="true" />
						)}
						<div class="body">
							<h2>{entry.data.title}</h2>
							<p class="desc">{entry.data.description}</p>
							<time class="date" datetime={entry.data.pubDate.toISOString()}>
								{entry.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</time>
						</div>
					</a>
				))}
			</div>
		)
	}
</BaseLayout>

<style>
	.kicker {
		font-family: var(--font-sans);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.8rem;
		font-weight: normal;
		color: var(--accent);
		margin: 0 0 0.2em;
	}
	.blurb {
		font-family: var(--font-sans);
		font-size: 1.15rem;
		color: var(--ink-soft);
		margin-bottom: 2em;
		max-width: 44rem;
	}
	.empty {
		font-family: var(--font-sans);
		color: var(--ink-soft);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em;
	}
	.card {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--rule);
		border-radius: 10px;
		overflow: hidden;
		background: var(--paper-raised);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.thumb {
		aspect-ratio: 710 / 399;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
	}
	.thumb-fallback {
		background: linear-gradient(135deg, var(--highlight), var(--paper));
	}
	.body {
		padding: 1em 1.05em 1.15em;
	}
	.card h2 {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.3;
		margin: 0;
	}
	.card:hover h2 {
		color: var(--accent);
	}
	.desc {
		margin: 0.55em 0 0;
		font-size: 0.95rem;
		color: var(--ink-soft);
	}
	.date {
		display: block;
		margin-top: 0.75em;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}
</style>
