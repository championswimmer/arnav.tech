---
import { getSpeakerDeckEmbed } from '../lib/speakerdeck';

interface Props {
	url: string;
	title?: string;
}

const { url, title } = Astro.props;
const embed = await getSpeakerDeckEmbed(url);
const label = title ?? embed?.title ?? 'SpeakerDeck presentation';
---

<div class="speakerdeck">
	{
		embed ? (
			<div class="frame" style={`--speakerdeck-ratio: ${embed.ratio};`}>
				<iframe
					src={embed.src}
					title={label}
					loading="lazy"
					allow="fullscreen"
					allowfullscreen
				/>
			</div>
		) : (
			<div class="fallback">The embedded deck could not be loaded right now.</div>
		)
	}
	<p class="link-out">
		<a href={url} target="_blank" rel="noopener">View on SpeakerDeck</a>
	</p>
</div>

<style>
	.speakerdeck {
		margin: 0 0 2rem;
	}
	.frame {
		aspect-ratio: var(--speakerdeck-ratio);
		width: 100%;
		border: 1px solid var(--rule);
		border-radius: 12px;
		overflow: hidden;
		background: #111;
		box-shadow: var(--box-shadow);
	}
	.frame iframe {
		width: 100%;
		height: 100%;
		display: block;
		border: 0;
		background: #111;
	}
	.fallback {
		padding: 1rem 1.1rem;
		border: 1px solid var(--rule);
		border-radius: 12px;
		background: var(--paper-raised);
		color: var(--ink-soft);
	}
	.link-out {
		margin: 0.7rem 0 0;
		font-size: 0.95rem;
		color: var(--ink-soft);
	}
</style>
