---
import FormattedDate from './FormattedDate.astro';
import { tagSlug, isTopicalTag } from '../lib/tags';

interface Props {
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
}

const { pubDate, updatedDate, tags = [] } = Astro.props;
const topicalTags = tags.filter(isTopicalTag);
---

{
	(pubDate || topicalTags.length > 0) && (
		<div class="meta">
			{pubDate && <FormattedDate date={pubDate} />}
			{updatedDate && (
				<span class="updated">
					· updated <FormattedDate date={updatedDate} />
				</span>
			)}
			{topicalTags.length > 0 && (
				<span class="tags">
					{topicalTags.map((tag) => (
						<a class="tag" href={`/tag/${tagSlug(tag)}/`}>
							#{tag}
						</a>
					))}
				</span>
			)}
		</div>
	)
}
<style>
	.meta {
		color: var(--ink-faint);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		align-items: center;
	}
	.tags {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
	}
	.tag {
		color: var(--accent);
		text-decoration: none;
	}
	.tag:hover {
		text-decoration: underline;
	}
</style>
