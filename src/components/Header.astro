---
import { Icon } from 'astro-icon/components';
import { SITE_TITLE, NAV_LINKS } from '../consts';
import { primarySocialLinks } from '../lib/social';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			{
				NAV_LINKS.map((link) =>
					'children' in link ? (
						<div class="dropdown">
							<button type="button" class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
								{link.label}
								<span class="caret" aria-hidden="true">▾</span>
							</button>
							<div class="dropdown-menu">
								{link.children.map((child) => (
									<HeaderLink href={child.href} class="dropdown-link">
										{'icon' in child && <Icon name={child.icon} width={18} height={18} />}
										{child.label}
									</HeaderLink>
								))}
							</div>
						</div>
					) : (
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					),
				)
			}
		</div>
		<div class="right-links">
			<div class="social-links">
				{
					primarySocialLinks.map((link) => (
						<a href={link.url} target="_blank" rel="me noopener" title={link.label}>
							<span class="sr-only">{link.label}</span>
							<Icon name={link.icon} width={20} height={20} />
						</a>
					))
				}
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		border-bottom: 1px solid var(--rule);
		background: color-mix(in srgb, var(--paper) 60%, transparent);
		backdrop-filter: blur(4px);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: var(--wide-width);
		margin: 0 auto;
		flex-wrap: wrap;
	}
	.brand {
		font-family: var(--font-essay);
		font-weight: 600;
		font-size: 1.25rem;
		color: var(--ink);
		text-decoration: none;
		padding: 0.8em 0;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
		flex-wrap: wrap;
	}
	nav a {
		padding: 0.5em 0.6em;
		color: var(--ink-soft);
		text-decoration: none;
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		font-weight: 600;
	}
	.dropdown {
		position: relative;
	}
	.dropdown-toggle {
		font: inherit;
		background: none;
		border: none;
		cursor: pointer;
		color: var(--ink-soft);
		padding: 0.5em 0.6em;
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
	}
	.dropdown-toggle:hover {
		color: var(--accent);
	}
	.caret {
		font-size: 0.7em;
		transition: transform 0.15s ease;
	}
	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 10em;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		padding: 0.35em;
		display: none;
		flex-direction: column;
		z-index: 20;
	}
	.dropdown-menu :global(a) {
		padding: 0.5em 0.6em;
		border-radius: 5px;
	}
	.dropdown-menu :global(a.dropdown-link) {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}
	.dropdown-menu :global(a.dropdown-link svg) {
		flex-shrink: 0;
		opacity: 0.85;
	}
	.dropdown-menu :global(a:hover) {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}
	/* Open on hover (desktop) or when toggled via keyboard/click. */
	.dropdown:hover .dropdown-menu,
	.dropdown.open .dropdown-menu {
		display: flex;
	}
	.dropdown:hover .caret,
	.dropdown.open .caret {
		transform: rotate(180deg);
	}
	.right-links {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.social-links {
		display: flex;
		gap: 0.5em;
		color: var(--ink-soft);
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.brand {
			order: 1;
		}
		.right-links {
			order: 2;
		}
		.internal-links {
			order: 3;
			flex-basis: 100%;
			justify-content: flex-start;
			border-top: 1px solid var(--rule);
			padding-bottom: 0.4em;
		}
	}
</style>

<script>
	// Click/keyboard toggle for nav dropdowns (hover handles desktop pointer use).
	document.querySelectorAll<HTMLElement>('.dropdown').forEach((dropdown) => {
		const toggle = dropdown.querySelector<HTMLButtonElement>('.dropdown-toggle');
		if (!toggle) return;
		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			const open = dropdown.classList.toggle('open');
			toggle.setAttribute('aria-expanded', String(open));
		});
	});
	document.addEventListener('click', () => {
		document.querySelectorAll('.dropdown.open').forEach((d) => {
			d.classList.remove('open');
			d.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
		});
	});
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		document.querySelectorAll('.dropdown.open').forEach((d) => {
			d.classList.remove('open');
			d.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
